<?xml version='1.0' encoding='UTF-8'?>
<scenario xmlns="https://dueca.tudelft.nl/testscenario" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://dueca.tudelft.nl/testscenario https://dueca.tudelft.nl/schemas/testscenario.xsd">
  <!-- scenario description

    This uses the DuecaTestCommunication project to test the abort button,
    and the performance of logging in the presence of an emergency

    To recreate:

    - Calibrate offset, mouse to upper left corner of a window, press F3
    - Operate DUECA/DUSIME state machine for the central server to work
    - modify the timing for the stop, to give the simulation time to create/
      delete flasher blips
    - operate to off and exit
  -->
  <project name="DuecaTestCommunication">
    <window>DUECA/DUSIME control panel</window>
    <window>Are you serious?</window>
  </project>
  <repository>https://github.com/dueca/</repository>
  <buildoptions>-DUSE_GTK3=ON</buildoptions>
  <execute>
    <platform>solo</platform>
    <node>solo</node>
  </execute>
  <actions>
    <check-image window="DUECA/DUSIME control panel" x="464" y="46" template="buttongreensel" testsize="64" timeout="10.0" wait="0.5" criterion="0.995"/>
    <check-image window="DUECA/DUSIME control panel" x="461" y="78" template="buttongraysel" testsize="64" timeout="10.0" wait="0.5" criterion="0.995"/>
    <click relative="true" x="-1" y="-1" button="Button.left" pressed="true" wait="0.3"/>
    <click relative="true" x="-1" y="-1" button="Button.left" pressed="false" wait="0.3"/>
    <check-image window="DUECA/DUSIME control panel" x="461" y="78" template="buttongreensel" testsize="64" timeout="10.0" wait="0.5" criterion="0.995"/>
    <check-image window="DUECA/DUSIME control panel" x="464" y="117" template="buttongraysel" testsize="64" timeout="10.0" wait="0.5" criterion="0.995"/>
    <click relative="true" x="2" y="2" button="Button.left" pressed="true" wait="0.3"/>
    <click relative="true" x="2" y="2" button="Button.left" pressed="false" wait="0.3"/>
    <check-image window="DUECA/DUSIME control panel" x="462" y="148" template="buttongreensel" testsize="64" timeout="10.0" wait="0.5" criterion="0.995"/>
    <check-image window="DUECA/DUSIME control panel" x="463" y="185" template="buttongraysel" testsize="64" timeout="10.0" wait="0.5" criterion="0.995"/>
    <click relative="true" x="1" y="0" button="Button.left" pressed="true" wait="0.3"/>
    <click relative="true" x="1" y="0" button="Button.left" pressed="false" wait="0.3"/>
    <check-image window="DUECA/DUSIME control panel" x="463" y="185" template="buttongreensel" testsize="64" timeout="10.0" wait="0.5" criterion="0.995"/>
    <check-image window="DUECA/DUSIME control panel" x="422" y="184" template="buttongraysel" testsize="64" timeout="10.0" wait="0.5" criterion="0.995"/>
    <click relative="true" x="4" y="-1" button="Button.left" pressed="true" wait="0.3"/>
    <click relative="true" x="4" y="-1" button="Button.left" pressed="false" wait="0.3"/>
    <check-image window="DUECA/DUSIME control panel" x="462" y="220" template="buttongraysel" testsize="64" timeout="10.0" wait="0.5" criterion="0.995"/>
    <click relative="true" x="0" y="1" button="Button.left" pressed="true" wait="0.3"/>
    <click relative="true" x="0" y="1" button="Button.left" pressed="false" wait="0.3"/>
    <check-image window="DUECA/DUSIME control panel" x="462" y="220" template="buttongreensel" testsize="64" timeout="10.0" wait="0.5" criterion="0.995"/>
    <check-image window="DUECA/DUSIME control panel" x="365" y="83" template="abortbutton" testsize="96" timeout="10.0" wait="20.5" criterion="0.995"/>
    <click relative="true" x="1" y="3" button="Button.left" pressed="true" wait="0.3"/>
    <click relative="true" x="1" y="3" button="Button.left" pressed="false" wait="0.3"/>
    <check-image window="DUECA/DUSIME control panel" x="365" y="91" template="abort-revert" testsize="96" timeout="10.0" wait="0.5" criterion="0.995"/>
    <click relative="true" x="-1" y="7" button="Button.left" pressed="true" wait="0.3"/>
    <click relative="true" x="-1" y="7" button="Button.left" pressed="false" wait="0.3"/>
    <check-image window="DUECA/DUSIME control panel" x="463" y="41" template="buttongraysel" testsize="64" timeout="10.0" wait="0.5" criterion="0.995"/>
    <snap name="dtcabort000.png" />
    <click relative="true" x="-1" y="0" button="Button.left" pressed="true" wait="0.3"/>
    <click relative="true" x="-1" y="0" button="Button.left" pressed="false" wait="0.3"/>
    <click relative="true" x="-1" y="0" button="Button.left" pressed="true" wait="0.3"/>
    <click relative="true" x="-1" y="0" button="Button.left" pressed="false" wait="0.3"/>
    <check-image window="DUECA/DUSIME control panel" x="15" y="-4" template="fileword" testsize="96" timeout="10.0" wait="0.5" criterion="0.995"/>
    <check-word window="DUECA/DUSIME control panel" x="15" y="-4" word="File" testsize="64" timeout="10.0" criterion="40" wait="0.5"/>
    <click relative="true" x="-2" y="0" button="Button.left" pressed="true" wait="0.3"/>
    <click relative="true" x="-2" y="0" button="Button.left" pressed="false" wait="0.3"/>
    <click relative="true" x="19" y="52" button="Button.left" pressed="true" wait="0.3"/>
    <click relative="true" x="19" y="52" button="Button.left" pressed="false" wait="0.3"/>
    <check-word window="Are you serious?" x="63" y="37" word="really" testsize="48" timeout="10.0" criterion="40" wait="0.5"/>
    <click relative="true" x="0" y="-3" button="Button.left" pressed="true" wait="0.3"/>
    <click relative="true" x="0" y="-3" button="Button.left" pressed="false" wait="0.3"/>
    <click relative="true" x="0" y="-3" button="Button.left" pressed="true" wait="0.3"/>
  </actions>
</scenario>
