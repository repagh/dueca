<?xml version="1.0"?>
<configuration
	xmlns="https://dueca.tudelft.nl/platform"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://dueca.tudelft.nl/platform https://dueca.tudelft.nl/schemas/platform.xsd">
	<machineclasses>
		<!-- Experiment Control Station -->
		<machineclass name="hmi-ecs" gui="gtk4">
			<modules>
				<project>
					<url>dgrpub:///FlexiStick.git</url>
					<module>flexi-stick</module>
				</project>
			</modules>
		</machineclass>
		<!-- Control Loading -->
		<machineclass name="hmi-io" gui="none">
			<config>
				# variant, can choose real hardware (hmi) or hmi-sim
				set(HMI_VARIANT hmi CACHE STRING "Choose a variant for the HMI io")

				# Find the relevant headers
				find_path(HMIIO_BASE_DIR NAMES
					hmi/HardwareInterface.hxx hmi/hmiio_calib_volts.h REQUIRED
					PATHS ${CMAKE_SOURCE_DIR}/../../gen-ecat-io)

				list(APPEND HMIIO_INCLUDE_DIRS
					${HMIIO_BASE_DIR}/hmi
					${HMIIO_BASE_DIR}
					${HMIIO_BASE_DIR}/build-${HMI_VARIANT})

				find_library(HMIIO_LIBRARY NAMES hmi-ecat-io REQUIRED
				  PATHS ${HMIIO_BASE_DIR}/build-${HMI_VARIANT})

				# define PROJECT_LIBRARIES with libraries needed on the current platform,
				set(PROJECT_LIBRARIES ${HMIIO_LIBRARY})

				# define PROJECT_INCLUDE_DIRS with include directories common to all on
				# the current platform
				set(PROJECT_INCLUDE_DIRS ${HMIIO_INCLUDE_DIRS})
      </config>
			<modules>
				<project>
					<url>dgrbase:///CSControlLoading.git</url>
					<module>IOController</module>
					<version>master</version>
				</project>
				<project>
					<url>dgrbase:///CSControlLoading.git</url>
					<module>ControlLoading</module>
					<version>master</version>
				</project>
				<project>
					<url>dgrbase:///CSControlLoading.git</url>
					<module>CLConfigurations</module>
					<version>master</version>
				</project>
				<project>
					<url>dgrbase:///CSControlLoading.git</url>
					<module>cl-analyser</module>
					<version>master</version>
				</project>
			</modules>
		</machineclass>
		<!-- image generation -->
		<machineclass name="hmi-ig" gui="none">
			<modules>
				<project>
					<url>dgrpub:///WorldView.git</url>
					<module>WorldView</module>
					<version>master</version>
				</project>
				<project>
					<url>dgrpub:///WorldView.git</url>
					<module>FlightGearViewer</module>
					<version>master</version>
				</project>
				<project>
					<url>dgrpub:///WorldView.git</url>
					<module pseudo="true">HMILabViewFiles</module>
					<version>master</version>
				</project>
				<project>
					<url>dgrpub:///WorldView.git</url>
					<module>SpecificationBase</module>
					<version>master</version>
				</project>
			</modules>
		</machineclass>
		<!-- Image generation and sound output -->
		<machineclass name="hmi-ig+" gui="none">
			<modules>
				<project>
					<url>dgrpub:///WorldView.git</url>
					<module>WorldView</module>
					<version>master</version>
				</project>
				<project>
					<url>dgrpub:///WorldView.git</url>
					<module>OSGViewer</module>
					<version>master</version>
				</project>
				<project>
					<url>dgrpub:///WorldView.git</url>
					<module pseudo="true">HMILabViewFiles</module>
					<version>master</version>
				</project>
				<project>
					<url>dgrpub:///WorldView.git</url>
					<module>SpecificationBase</module>
					<version>master</version>
				</project>
				<project>
					<url>dgrpub:///WorldListener.git</url>
					<module>OpenALListener</module>
					<version>master</version>
				</project>
				<project>
					<url>dgrpub:///WorldListener.git</url>
					<module>WorldListener</module>
					<version>master</version>
				</project>
			</modules>
		</machineclass>
		<machineclass name="hmi-efis" gui="none" />
		<machineclass name="hmi-host" gui="none">
			<modules>
				<project>
					<url>dgrpub:///FlexiStick.git</url>
					<module>flexi-stick</module>
				</project>
			</modules>
		</machineclass>
	</machineclasses>
	<platform name="hmilab" comm-master="dutmms4">
		<node name="dutmms1" machineclass="hmi-ecs" node-number="0" />
		<node name="dutmms6" machineclass="hmi-host" />
		<node name="dutmms4" machineclass="hmi-io" />
		<node name="dutmms2" machineclass="hmi-efis" />
		<node name="dutmms14" machineclass="hmi-ig+" />
		<node name="dutmms15" machineclass="hmi-ig" />
		<node name="dutmms16" machineclass="hmi-ig" />
	</platform>
</configuration>